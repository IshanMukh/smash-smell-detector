{
  "name": "smash-smell-detector",
  "publisher": "smash-dev",
  "displayName": "SMASH - Architecture Smell Detector",
  "description": "Detects class-level architectural smells in Java, Python, C#, C++, TypeScript, and JavaScript using LLM analysis",
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onLanguage:java", "onLanguage:python", "onLanguage:csharp", "onLanguage:cpp", "onLanguage:typescript", "onLanguage:javascript"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smash.analyzeFile",
        "title": "SMASH: Analyze Current File for Architecture Smells"
      }
    ],
    "configuration": {
      "title": "SMASH Smell Detector",
      "properties": {
        "smash.backendUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "URL of the SMASH backend server"
        },
        "smash.enableOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically analyze supported files on Ctrl+S (Java, Python, C#, C++, TypeScript, JavaScript)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
